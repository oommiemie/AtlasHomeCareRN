{
  "expo": {
    "name": "Atlas HomeCare",
    "slug": "atlas-homecare",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oommie.atlashomecarern",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ใช้ตำแหน่งของคุณเพื่อแสดงเส้นทางไปบ้านผู้ป่วย",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ],
        "CFBundleDevelopmentRegion": "th",
        "CFBundleLocalizations": [
          "th",
          "en"
        ],
        "NSCameraUsageDescription": "ใช้กล้องเพื่อถ่ายภาพบัตรประชาชน และถ่ายภาพส่งให้ผู้ช่วย AI ช่วยดู",
        "NSPhotoLibraryUsageDescription": "ใช้รูปจากคลังภาพเป็นภาพประจำตัวของสมาชิกในบ้าน และส่งให้ผู้ช่วย AI ช่วยดู",
        "NSMotionUsageDescription": "ใช้เซนเซอร์การเคลื่อนไหวเพื่อให้แสงบนหน้าจอเปลี่ยนตามการเอียงเครื่อง",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSLocalNetworkUsageDescription": "ใช้เชื่อมต่อกับเครื่องพัฒนาในเครือข่ายเดียวกัน เพื่อโหลดโค้ดระหว่างการพัฒนา",
        "NSBonjourServices": [
          "_http._tcp"
        ],
        "NSSpeechRecognitionUsageDescription": "ใช้การรู้จำเสียงเพื่อเปลี่ยนสิ่งที่คุณพูดเป็นข้อความ ทั้งในสมุดจด การค้นหา และการคุยกับผู้ช่วย AI โดยประมวลผลบนเครื่องนี้",
        "NSMicrophoneUsageDescription": "ใช้ไมโครโฟนเพื่อฟังสิ่งที่คุณพูด สำหรับจดบันทึกลงสมุดจด ค้นหาด้วยเสียง และคุยกับผู้ช่วย AI",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "appleTeamId": "FFFGJANVWN",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.oommie.atlashomecarern",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "react-native-bottom-tabs",
      "expo-location",
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ใช้ Face ID เพื่อปลดล็อก Atlas HomeCare แทนการกรอกรหัส PIN"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#077DD7"
        }
      ],
      "expo-speech-recognition",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withAndroidTheme",
      "./plugins/withClearAndroidBlur",
      [
        "expo-audio",
        {
          "microphonePermission": "ใช้ไมโครโฟนเพื่อฟังสิ่งที่คุณพูด สำหรับจดบันทึกลงสมุดจด ค้นหาด้วยเสียง และคุยกับผู้ช่วย AI"
        }
      ],
      "expo-localization"
    ],
    "scheme": "atlashomecare",
    "extra": {
      "eas": {
        "projectId": "e548b892-905f-4a76-881a-c719d0f661dc"
      }
    },
    "owner": "oommie",
    "locales": {
      "th": "./locales/th.json",
      "en": "./locales/en.json"
    },
    "experiments": {
      "baseUrl": "/AtlasHomeCareRN"
    }
  }
}
