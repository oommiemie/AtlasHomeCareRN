+#if os(iOS)
+/// Atlas: the search button beside the iPad's tab bar. See the note where
+/// it is attached, in `TabViewImpl`.
+@available(iOS 26.0, *)
+final class AtlasSearchButton: UIView {
+  private static let tagId = 0xA71A5
+  private var onPress: (() -> Void)?
+  private weak var bar: UITabBar?
+  private let glass: UIVisualEffectView = {
+    let effect = UIGlassEffect()
+    effect.isInteractive = true
+    return UIVisualEffectView(effect: effect)
+  }()
+  private let button = UIButton(type: .system)
+
+  static func attach(to controller: UITabBarController, label: String, onPress: @escaping () -> Void) {
+    guard let host = controller.view else { return }
+    let view = (host.viewWithTag(tagId) as? AtlasSearchButton) ?? {
+      let made = AtlasSearchButton()
+      made.tag = tagId
+      host.addSubview(made)
+      // Re-placed whenever the bar lays out — a rotation, a split view,
+      // the bar hiding — by a view riding inside it.
+      let watcher = AtlasLayoutWatcher(frame: controller.tabBar.bounds)
+      watcher.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+      watcher.isUserInteractionEnabled = false
+      watcher.onLayout = { [weak made] in made?.place() }
+      controller.tabBar.addSubview(watcher)
+      return made
+    }()
+    view.onPress = onPress
+    view.bar = controller.tabBar
+    view.button.accessibilityLabel = label
+    view.place()
+    DispatchQueue.main.async { view.place() }
+  }
+
+  private init() {
+    super.init(frame: .zero)
+    glass.clipsToBounds = true
+    addSubview(glass)
+    let config = UIImage.SymbolConfiguration(pointSize: 19, weight: .semibold)
+    button.setImage(UIImage(systemName: "magnifyingglass", withConfiguration: config), for: .normal)
+    button.tintColor = .label
+    button.addTarget(self, action: #selector(pressed), for: .touchUpInside)
+    glass.contentView.addSubview(button)
+  }
+
+  required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+
+  @objc private func pressed() { onPress?() }
+
+  /// Where the bar's capsule is: the platter iOS 26 draws the tabs on
+  /// (`_UITabBarPlatterView`), or failing that the smallest view around the
+  /// tab buttons that is narrower than the bar.
+  private func capsule(in host: UIView) -> CGRect? {
+    guard let bar else { return nil }
+    let visible = { (v: UIView) in !v.isHidden && v.alpha > 0.01 && v.bounds.width > 0 }
+    var platter: UIView?
+    var buttons: [UIView] = []
+    func walk(_ v: UIView) {
+      for sub in v.subviews where !(sub is AtlasLayoutWatcher) {
+        let name = String(describing: type(of: sub))
+        if platter == nil && name.contains("Platter") && visible(sub) {
+          platter = sub
+        } else if name.contains("TabButton") || name.contains("TabBarButton") {
+          if visible(sub) { buttons.append(sub) }
+        } else {
+          walk(sub)
+        }
+      }
+    }
+    walk(bar)
+    if let platter { return platter.convert(platter.bounds, to: host) }
+    guard let first = buttons.first else { return nil }
+    let union = buttons.reduce(CGRect.null) { $0.union($1.convert($1.bounds, to: host)) }
+    var up = first.superview
+    while let v = up, v !== bar {
+      let r = v.convert(v.bounds, to: host)
+      if r.contains(union.insetBy(dx: 1, dy: 1)) && r.width < bar.bounds.width * 0.95 {
+        return r
+      }
+      up = v.superview
+    }
+    return union.insetBy(dx: -4, dy: -4)
+  }
+
+  func place() {
+    guard let host = superview, let bar else { return }
+    guard !bar.isHidden, bar.alpha > 0.01, let cap = capsule(in: host), cap.height > 0 else {
+      isHidden = true
+      return
+    }
+    isHidden = false
+    host.bringSubviewToFront(self)
+    let size = cap.height
+    frame = CGRect(x: cap.maxX + 12, y: cap.minY, width: size, height: size)
+    glass.frame = bounds
+    glass.layer.cornerRadius = size / 2
+    button.frame = glass.contentView.bounds
+  }
+}
+
+/// Calls back whenever the view it sits in lays itself out.
+final class AtlasLayoutWatcher: UIView {
+  var onLayout: (() -> Void)?
+  override func layoutSubviews() {
+    super.layoutSubviews()
+    DispatchQueue.main.async { [weak self] in self?.onLayout?() }
+  }
+}
+#endif
